# Worth The Trip — Stripe config (copy to .env)
# Never commit .env. Fill in your real keys from Stripe Dashboard → Developers → API keys.

# Live (production) keys — required before pushing live
# Get them: https://dashboard.stripe.com/live/apikeys
STRIPE_PUBLISHABLE_KEY=pk_live_...replace-me...
STRIPE_SECRET_KEY=sk_live_...replace-me...

# Webhook signing secret
# Create + copy from Dashboard → Developers → Webhooks → + add endpoint
STRIPE_WEBHOOK_SECRET=whsec_...replace-me...

# For local testing, use the test keys instead (Dashboard → Developers → API keys)
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_test_...

# SendGrid SMTP — required for account verification emails
# Get the key: https://app.sendgrid.com/settings/api_keys
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxx...replace-me...
SMTP_FROM="Worth The Trip" <no-reply@worththetripapp.com>
WTT_BASE_URL=https://worththetripapp.com
